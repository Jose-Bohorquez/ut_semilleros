#RewriteEngine On

# Si el archivo o carpeta no existe
#RewriteCond %{REQUEST_FILENAME} !-f
#RewriteCond %{REQUEST_FILENAME} !-d

# redirigir todo a index.html (SPA router)
#RewriteRule ^ index.html [L]



Options -MultiViews
RewriteEngine On

# ── REGLA 1: Primero — rutas /api/* van al backend Laravel ──────
# Debe ir ANTES que la regla SPA, si no el SPA se come las peticiones API
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^api/(.*)$ /api/public/index.php [L,QSA]

# ── REGLA 1b (RNF03): archivos de desarrollo no se publican ──────
# docker-compose.yml, Dockerfile, README.md, *.txt de arquitectura, docs/…
# se servían como texto (verificado 2026-09-28). Solo en la raíz: no toca SGAA/.
RewriteCond %{REQUEST_URI} !^/robots\.txt$
RewriteRule ^(Dockerfile|docker-compose\.ya?ml|\.gitignore|\.dockerignore|[^/]+\.(md|txt|sh|lock|ya?ml|log|sql|bak|puml))$ - [R=404,L]
RewriteRule ^(docs|apache|scripts|graphify-out|\.claude)(/|$) - [R=404,L]

# ── REGLA 2: Archivos y carpetas reales → servir directo ─────────
# (imágenes, css, js, manifest.json, service-worker.js, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── REGLA 3: Todo lo demás → SPA (tu router JS) ──────────────────
# Esta es tu regla original, al final
RewriteRule ^ index.html [L]
# ── Cache-Control para módulos JS y CSS ──────────────────────────
# Los .js son ES modules importados dinámicamente por múltiples rutas
# cruzadas (core/router.js, layout/*, módulos/*); el service worker ya
# implementa network-first para ellos, pero un Cache-Control largo en
# origen/CDN anula esa estrategia y sirve versiones viejas tras cada
# despliegue. Cache corto + revalidación evita tener que versionar cada
# import a mano (bug real encontrado 2026-07-28).
<IfModule mod_headers.c>
    # RNF03: cabeceras de seguridad (la API agrega las suyas en SecurityHeaders)
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always unset X-Powered-By
    Header unset X-Powered-By

    <FilesMatch "\.js$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.css$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>
    # El HTML de la SPA y el propio SW siempre se revalidan: sin Cache-Control el
    # navegador aplicaba caché heurística y un deploy podía tardar días en verse.
    <FilesMatch "^(index\.html|service-worker\.js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
