# ========================================================
# 🌐 Proyecto UT-Semilleros (Laravel + Vue + Docker)
# ========================================================

# ⚙️ Archivos de entorno (no se deben subir nunca)
.env
.env.*
!.env.example          # se conserva solo la plantilla

# 🧩 Dependencias PHP y Node
/vendor/
node_modules/
frontend/node_modules/
package-lock.json
frontend/package-lock.json

# ⚙️ Archivos compilados del frontend
/public/build/
/public/hot/
frontend/dist/
/api/public/build/

# 🗄️ Archivos generados o temporales
/storage/*.key
/storage/app/public/
storage/logs/
bootstrap/cache/*.php
.phpunit.result.cache
.phpactor.json

# 🧱 Configuración de IDEs y entornos de desarrollo
/.idea/
/.vscode/
/.fleet/
/zed/
/*.code-workspace

# 🧰 Herramientas opcionales de Laravel Nova, Sail, Homestead
.nova/
.sail/
Homestead.json
Homestead.yaml

# 🐋 Docker y bases de datos
/db/data/
db_data/
docker-compose.override.yml
*.log

# 🖼️ Archivos de sistema
.DS_Store
Thumbs.db

# ========================================================
# ✅ Archivos que SÍ se deben versionar
# ========================================================
!.gitignore
!composer.json
!composer.lock
!package.json
!frontend/package.json
!vite.config.js
!frontend/vite.config.js
!artisan
!Dockerfile
!docker-compose.yml
!apache/laravel.conf