# ========================================================
# 🌐 Laravel 12 - Proyecto con Docker
# ========================================================

# ⚙️ Archivos de entorno
.env
.env.*
# se conserva la plantilla de ejemplo
!.env.example

# 🧩 Dependencias PHP y Node
/vendor/
node_modules/
package-lock.json

# ⚙️ Compilados de frontend
/public/build/
/public/hot/

# 🗄️ Archivos generados o temporales
/storage/*.key
/storage/app/public/
storage/logs/
bootstrap/cache/*.php
.phpunit.result.cache
.phpactor.json

# 🧱 Configuración de IDEs y entornos de desarrollo
/.idea/
/.vscode/
/.fleet/
/.zed/
*.code-workspace

# 🧰 Herramientas de Laravel Nova, Sail, etc.
.nova/
.sail/
Homestead.json
Homestead.yaml

# 🐋 Docker y base de datos
# base de datos persistente local (git NO admite comentarios al final de la línea)
/db/data/
/docker-compose.override.yml
*.log

# 🖼️ Archivos de sistema
.DS_Store
Thumbs.db

# ========================================================
# ✅ Archivos que SÍ se deben versionar (por convención)
# ========================================================
!.gitignore
!composer.json
!composer.lock
!package.json
!vite.config.js
!artisan
!Dockerfile
!docker-compose.yml
!apache/laravel.conf

# ========================================================
# 📦 Propios de esta carpeta (2026-09-27)
# ========================================================
# Proyectos hermanos: SGAA tiene su propio repo (asistencia-app); el otro es historia muerta
/SGAA/
/todo_ut-edu.space_old/
# Backups redundantes del código
*.zip
# graphify: se versiona el grafo, no la caché ni rutas locales
graphify-out/cache/
graphify-out/cost.json
graphify-out/.graphify_python

# Informes de QA: describen vulnerabilidades aún sin corregir en producción; no versionar en el repo
# público hasta que estén cerradas (2026-09-27)
docs/qa/
graphify-out/20*/

# Contraseñas de las cuentas de prueba en producción (mismo patrón que SGAA) — nunca en git,
# el repo es público (2026-09-29)
credenciales_prueba.txt
