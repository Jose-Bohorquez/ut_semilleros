# ========================================================
# 🌐 Laravel 12 - Proyecto con Docker
# ========================================================

# ⚙️ Archivos de entorno
.env
.env.*
# se conserva la plantilla de ejemplo (git no admite comentarios al final de la línea)
!.env.example

# 🧩 Dependencias PHP y Node
/vendor/
node_modules/
package-lock.json

# ⚙️ Compilados de frontend
/public/build/
/public/hot/

# 🗄️ Archivos generados o temporales
/storage/*.key
/storage/app/public/
storage/logs/
bootstrap/cache/*.php
.phpunit.result.cache
.phpactor.json

# 🧱 Configuración de IDEs y entornos de desarrollo
/.idea/
/.vscode/
/.fleet/
/.zed/
*.code-workspace

# 🧰 Herramientas de Laravel Nova, Sail, etc.
.nova/
.sail/
Homestead.json
Homestead.yaml

# 🐋 Docker y base de datos
# base de datos persistente local
/db/data/
/docker-compose.override.yml
*.log

# 🖼️ Archivos de sistema
.DS_Store
Thumbs.db

# ========================================================
# ✅ Archivos que SÍ se deben versionar (por convención)
# ========================================================
!.gitignore
!composer.json
!composer.lock
!package.json
!vite.config.js
!artisan
!Dockerfile
!docker-compose.yml
!apache/laravel.conf
